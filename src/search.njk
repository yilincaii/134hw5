---
title: Search
layout: base.njk
permalink: /search/
extraScripts:
  - /js/search.js
---
<header>
	{% include "header.njk" %}
	<h1>Search</h1>
</header>

<main id="main-content" data-pagefind-ignore>
	<noscript>
		<p>Search needs JavaScript to work. You can browse everything on the <a href="/sitemap.xml">sitemap</a> instead.</p>
	</noscript>

	<form id="search-form" role="search">
		<label for="search-input">Search this site</label>
		<input type="search" id="search-input" name="q" autocomplete="off">
		<button type="submit">Search</button>
	</form>

	<p id="search-status" class="visually-hidden" aria-live="polite"></p>

	<ul id="search-results"></ul>
</main>